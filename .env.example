# Supabase — من Settings → API في لوحة مشروعك
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# مفتاح سري عشوائي وطويل لتوقيع JWT (غيّره قبل النشر)
JWT_SECRET=

# رابط أو روابط الواجهة المنشورة المفصولة بفاصلة، ويُستخدم في CORS وروابط إعادة التعيين
FRONTEND_URL=https://your-domain.example,https://platform-znx6.vercel.app

# Marketplace / Storage
COURSE_FILES_BUCKET=course-files
REVIEW_VIDEO_BUCKET=review-media

# Paymob legacy Accept API — تُضاف في Render فقط، ولا تُرسل إلى الفرونت إند
PAYMOB_API_BASE_URL=https://accept.paymob.com/api
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
PAYMOB_DEFAULT_PHONE=+201000000000

# AI Mentor (اختياري — الكود الحالي يستخدم OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=ash

# Whop legacy integration (اختياري أثناء الانتقال إلى Paymob)
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=

# Brevo transactional email (اختياري)
BREVO_API_KEY=
EMAIL_FROM="منصة التسويق <onboarding@resend.dev>"

PORT=4000
