# Supabase — من Settings → API في لوحة مشروعك
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# مفتاح سري عشوائي وطويل لتوقيع الـ JWT (غيّره قبل النشر)
JWT_SECRET=

# رابط الواجهة الأمامية المنشورة (يُستخدم في CORS وفي رابط إعادة تعيين كلمة السر)
FRONTEND_URL=

# Whop (اختياري — للتفعيل التلقائي عند الاشتراك)
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=

# المرشد الذكي (اختياري)
ANTHROPIC_API_KEY=

# إرسال إيميلات نسيت كلمة السر عبر Resend (اختياري — لو فاضي هيطبع الرابط في اللوجز بس)
RESEND_API_KEY=
EMAIL_FROM="منصة التسويق <onboarding@resend.dev>"

PORT=4000
